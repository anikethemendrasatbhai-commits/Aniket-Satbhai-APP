import threading
import time

def counting():
    for i in range(1, 6):
        print("Counting:", i)
        time.sleep(1)

def squares():
    for i in range(1, 6):
        print("Square of", i, "=", i*i)
        time.sleep(1)

def cubes():
    for i in range(1, 6):
        print("Cube of", i, "=", i*i*i)
        time.sleep(1)

# Creating threads
t1 = threading.Thread(target=counting)
t2 = threading.Thread(target=squares)
t3 = threading.Thread(target=cubes)

print("Smart Math Learning App Started")

# Starting threads
t1.start()
t2.start()
t3.start()

# Waiting for threads
t1.join()
t2.join()
t3.join()

print("All mathematical operations completed.")
