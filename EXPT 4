# Calculate the nth Fibonacci number efficiently

def fibonacci(n):
    if n <= 1:
        return n

    a = 0
    b = 1

    for i in range(2, n + 1):
        c = a + b
        a = b
        b = c

    return b

n = int(input("Enter the value of n: "))

print("The", n, "th Fibonacci number is:", fibonacci(n))
