import numpy as np

# Create a one-dimensional array from 1 to 10
arr = np.arange(1, 11)
print("Original Array:", arr)

# Create arrays
print("Zeros:", np.zeros(5))
print("Ones:", np.ones(5))
print("Even Numbers:", np.arange(2, 11, 2))
print("Linear Space:", np.linspace(1, 10, 5))

# Indexing and slicing
print("First Element:", arr[0])
print("Elements from 2 to 5:", arr[1:5])

# Sorting
print("Sorted Array:", np.sort(arr))

# Mathematical operations
print("Addition:", arr + 2)
print("Subtraction:", arr - 2)
print("Multiplication:", arr * 2)
print("Division:", arr / 2)

# Aggregate functions
print("Maximum:", arr.max())
print("Minimum:", arr.min())
print("Sum:", arr.sum())
print("Mean:", arr.mean())
print("Standard Deviation:", arr.std())
