import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# ----- Create a customer churn dataset (synthetic) -----
np.random.seed(7)
n = 200

df = pd.DataFrame({
    "CustomerID": range(1, n + 1),
    "Tenure": np.random.randint(1, 72, n),
    "MonthlyCharges": np.round(np.random.normal(65, 20, n), 2),
    "Contract": np.random.choice(["Month-to-month", "One year", "Two year"], n, p=[.55, .25, .2])
})

df["Churn"] = np.where(
    ((df["Contract"] == "Month-to-month") & (np.random.rand(n) < .5)) |
    (np.random.rand(n) < .1),
    "Yes", "No"
)

df.loc[np.random.choice(n, 10, replace=False), "MonthlyCharges"] = np.nan
df.loc[[5, 50], "MonthlyCharges"] = [400.0, 380.0]

df.to_csv("churn.csv", index=False)

# ----- Explore -----
df = pd.read_csv("churn.csv")

print("Shape:", df.shape)
print("\nFirst 5 rows:\n", df.head())
print("\nDescriptive statistics:\n", df.describe().round(2))
print("\nMissing values:\n", df.isnull().sum())
print("\nChurn counts:\n", df["Churn"].value_counts())

print("\nChurn rate by contract:\n",
      df.groupby("Contract")["Churn"].apply(
          lambda x: (x == "Yes").mean()
      ).round(2))

# ----- Handle missing data -----
df["MonthlyCharges"] = df["MonthlyCharges"].fillna(
    df["MonthlyCharges"].median()
)

# ----- Detect and handle outliers (IQR) -----
q1, q3 = df["MonthlyCharges"].quantile([.25, .75])
iqr = q3 - q1

low, high = q1 - 1.5 * iqr, q3 + 1.5 * iqr

mask = ((df["MonthlyCharges"] < low) |
        (df["MonthlyCharges"] > high))

print(f"\nOutlier bounds: {low:.2f} to {high:.2f} | Outliers found: {mask.sum()}")

df = df[~mask]

print("Shape after cleaning:", df.shape)
print("Missing values after cleaning:", df.isnull().sum().sum())

# ----- Visualize -----
fig, ax = plt.subplots(1, 3, figsize=(13, 3.6))

ax[0].hist(df["MonthlyCharges"], bins=20, color="#7030A0")
ax[0].set_title("Monthly Charges")

ax[1].boxplot(df["MonthlyCharges"])
ax[1].set_title("Boxplot (after cleaning)")

df["Churn"].value_counts().plot(
    kind="bar", ax=ax[2], color=["#7030A0", "#999999"]
)
ax[2].set_title("Churn")

plt.tight_layout()
plt.savefig("eda_plots.png", dpi=120)

df.to_csv("churn_clean.csv", index=False)

print("Saved eda_plots.png and churn_clean.csv")
